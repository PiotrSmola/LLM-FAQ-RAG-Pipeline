# --- Docker (docker-compose.yml, start.bat / start.sh) ---
# Katalog z plikami GGUF modeli. Bez tej zmiennej start.bat / start.sh używa ./models/gguf albo, jeśli są
# tam wszystkie pliki, katalogu modeli LM Studio (~/.lmstudio/models); w razie braku pobiera modele (~7,8 GB).
# GGUF_DIR=C:/Users/<uzytkownik>/.lmstudio/models
# Porty na komputerze (aplikacja, serwer LLM, serwer embeddingów)
APP_PORT=7860
LLM_PORT=8080
EMBEDDING_PORT=8081

# --- Uruchamianie skryptów i notebooków poza Dockerem (python app.py, scripts/*.py) ---
# Adresy serwerów modeli. Kontenery z docker-compose.yml są dostępne pod tymi portami na komputerze.
# W kontenerze aplikacji adresy ustawia docker-compose.yml (http://llm:8080/v1, http://embeddings:8080/v1).
# Bez Dockera można użyć LM Studio: oba adresy http://localhost:1234/v1
LLM_BASE_URL=http://localhost:8080/v1
EMBEDDING_BASE_URL=http://localhost:8081/v1
# Serwery lokalne nie sprawdzają klucza, ale klient OpenAI potrzebuje dowolnej wartości
LLM_API_KEY=local

# Identyfikatory modeli (aliasy nadane w docker-compose.yml, takie same jak w LM Studio)
LLM_MODEL=google/gemma-4-12b-qat
EMBEDDING_MODEL=text-embedding-bge-m3

# Klasyfikator (ścieżka do wytrenowanego modelu lub nazwa z HuggingFace)
CLASSIFIER_PATH=models/herbert-faq
CLASSIFIER_THRESHOLD=0.55

# Retrieval
TOP_K=4
