# Adres lokalnego serwera LM Studio (Developer -> Start Server, domyślnie port 1234)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LM Studio nie wymaga klucza, ale klient OpenAI potrzebuje dowolnej wartości
LMSTUDIO_API_KEY=lm-studio

# Identyfikatory modeli widoczne w LM Studio (`lms ls` lub GET /v1/models)
LLM_MODEL=google/gemma-4-12b-qat
EMBEDDING_MODEL=text-embedding-bge-m3

# Klasyfikator (ścieżka do wytrenowanego modelu lub nazwa z HuggingFace)
CLASSIFIER_PATH=models/herbert-faq
CLASSIFIER_THRESHOLD=0.55

# Retrieval
TOP_K=4
